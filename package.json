{
  "name": "clipify",
  "productName": "Clipify",
  "version": "0.1.0",
  "description": "Turn Twitch clips into short-form videos, publish them and track how they perform.",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "engine:install": "rolldown scripts/engine-install.ts --platform node --format esm --external ffmpeg-static --external ffprobe-static -o out/scripts/engine-install.mjs && node out/scripts/engine-install.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "better-sqlite3": "^13.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.72.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  },
  "author": "Clipify contributors"
}
